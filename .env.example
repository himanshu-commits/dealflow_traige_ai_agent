# Copy to .env and fill in. docker compose reads .env automatically.
# Never commit .env.

# --- LLM ---
# "openai" calls the OpenAI API (needs OPENAI_API_KEY).
# "replay" is a no-network demo mode: it only recognises the bundled sample pitches.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Any OpenAI chat model that supports structured outputs. Pick a small one.
OPENAI_MODEL=gpt-4o-mini

# --- Behaviour ---
# Load demo opportunities into an empty database on backend start.
SEED_ON_START=true
# Fetch the company's own website for context (HTTPS, public hosts only).
ENRICHMENT_ENABLED=true
